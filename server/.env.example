# Backend do Verifica Cidadão — copie para `.env` (nunca commitar o .env)

# Porta do servidor
PORT=8787

# Origem do front-end autorizada via CORS (em dev o Vite já usa proxy)
FRONTEND_ORIGIN=http://localhost:5173

# --- Provedor de IA (API compatível com OpenAI /chat/completions) ---
# OpenAI:  https://api.openai.com/v1
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Busca ---
# brave (recomendado, exige BRAVE_API_KEY) | duckduckgo (apenas demonstração, sem chave)
SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# --- Limite de uso por IP (memória do processo) ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
